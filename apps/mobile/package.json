{
    "name": "@finance/mobile",
    "version": "1.10.0",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "dev": "expo start --dev-client",
        "prebuild": "expo prebuild --platform android --no-install",
        "build:apk": "expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug -PreactNativeArchitectures=x86_64,arm64-v8a",
        "build:benchmark": "expo prebuild --platform android --no-install && cd android && EXPO_PUBLIC_BENCHMARK=1 ./gradlew assembleDebug assembleRelease -PreactNativeArchitectures=x86_64,arm64-v8a",
        "typecheck": "tsc -p tsconfig.json",
        "test": "jest"
    },
    "dependencies": {
        "@expo-google-fonts/ibm-plex-sans": "0.4.1",
        "@finance/client": "workspace:*",
        "@finance/core": "workspace:*",
        "@finance/sqlite-expo": "workspace:*",
        "@finance/tokens": "workspace:*",
        "@shopify/flash-list": "2.3.2",
        "@tanstack/react-query": "5.104.1",
        "expo": "58.0.23",
        "expo-constants": "58.0.15",
        "expo-crypto": "58.0.7",
        "expo-dev-client": "58.0.18",
        "expo-file-system": "58.0.13",
        "expo-font": "58.0.11",
        "expo-linking": "58.0.16",
        "expo-router": "58.0.30",
        "expo-splash-screen": "58.0.13",
        "expo-sqlite": "58.0.15",
        "expo-status-bar": "58.0.4",
        "expo-system-ui": "58.0.7",
        "nativewind": "4.2.7",
        "react": "19.3.0",
        "react-hook-form": "7.89.0",
        "react-native": "0.88.1",
        "react-native-css-interop": "0.2.7",
        "react-native-gesture-handler": "3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "5.11.1",
        "react-native-screens": "4.30.1",
        "react-native-svg": "15.16.0",
        "react-native-worklets": "0.13.0",
        "tailwindcss": "3.4.19",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@babel/plugin-transform-react-jsx": "7.29.7",
        "@finance/sqlite-better": "workspace:*",
        "@react-native/jest-preset": "0.88.1",
        "@testing-library/react-native": "14.1.0",
        "@types/jest": "30.0.0",
        "@types/node": "24.19.0",
        "@types/react": "19.3.0",
        "babel-preset-expo": "58.0.24",
        "jest": "30.5.2",
        "jest-expo": "58.0.14",
        "test-renderer": "1.3.0",
        "typescript": "6.0.3"
    }
}
