{
    "name": "finance",
    "version": "1.52.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.8.1",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "embed:migrations": "node scripts/embed-migrations.mjs",
        "golden:generate": "pnpm --filter @finance/core --filter @finance/client exec vitest run test/golden -u",
        "db:history": "node --experimental-transform-types --no-warnings=ExperimentalWarning packages/core/scripts/generate-history-database.ts",
        "bench:core": "node --experimental-transform-types --no-warnings=ExperimentalWarning packages/core/scripts/benchmark-database.ts",
        "tokens:css": "pnpm --filter @finance/tokens generate",
        "dev:desktop": "pnpm --filter @finance/desktop dev",
        "build:desktop": "pnpm --filter @finance/desktop build",
        "dist:desktop": "pnpm --filter @finance/desktop dist",
        "dev:mobile": "pnpm --filter @finance/mobile dev",
        "build:mobile": "pnpm --filter @finance/mobile build:apk",
        "build:mobile-contract": "pnpm --filter @finance/mobile-contract build:apk",
        "emulator:android": "bash scripts/android-emulator.sh",
        "bench:android": "bash scripts/android-benchmark.sh",
        "lint": "eslint .",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "check": "pnpm lint && pnpm typecheck && pnpm test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.11.0",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.71.0"
    }
}
