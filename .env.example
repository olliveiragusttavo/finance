# Copie para .env (ignorado pelo git) e preencha — nunca commitar o .env.
# Carregado no container do devcontainer pelo env_file do .devcontainer/compose.yaml.

# Token de longa duração gerado com `claude setup-token` no host. Faz o Claude Code
# (extensão do VS Code e CLI) dentro do container entrar já autenticado, sem refazer
# o login a cada rebuild.
CLAUDE_CODE_OAUTH_TOKEN=
