        <mxCell id="c_q2eOROvbPMDOu2QuyJ-30" parent="1" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=50;horizontalStack=0;rounded=1;fontSize=14;fontStyle=0;strokeWidth=2;resizeParent=0;resizeLast=1;shadow=0;dashed=0;align=center;arcSize=4;whiteSpace=wrap;html=1;fillColor=#bac8d3;strokeColor=#23445d;" value="attachments" vertex="1">
          <mxGeometry height="120" width="160" x="600" y="800" as="geometry" />
        </mxCell>
        <mxCell id="c_q2eOROvbPMDOu2QuyJ-43" parent="c_q2eOROvbPMDOu2QuyJ-30" style="align=left;spacingLeft=4;spacingRight=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;" value="- name: varchar" vertex="1">
          <mxGeometry height="70" width="160" y="50" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-1" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" value="&quot;Partners&quot; defines a list of individuals associated with the profile if it is a business type. Each partner has a specific percentage share; this is used to display the distribution of expenses and revenue based on that partner&#39;s percentage." vertex="1">
          <mxGeometry height="100" width="230" x="-230" y="310" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-2" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" value="Profiles: think of this as a user table. All records are linked to this profile table. If a profile is deleted, everything associated with it is deleted.&lt;div&gt;&lt;br&gt;The profile can be personal or business&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="150" x="-260" y="720" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-4" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" value="Transfers and investments can be linked to another account to designate the destination of the funds." vertex="1">
          <mxGeometry height="110" width="120" x="15" y="830" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-5" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" value="Both tables will have one record per month." vertex="1">
          <mxGeometry height="100" width="100" x="90" y="530" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-8" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" value="The transaction link with partners is to define who is the partner that pay that transaction" vertex="1">
          <mxGeometry height="100" width="110" x="40" y="270" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-9" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" value="simple list with note" vertex="1">
          <mxGeometry height="100" width="100" x="-750" y="700" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-22" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" value="Every table also carries created_at, updated_at and deleted_at (soft delete). Left out of the boxes above to keep them readable." vertex="1">
          <mxGeometry height="130" width="160" x="-750" y="400" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-23" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" value="Attachments store only the file name (extension included). The bytes live on disk, at a path derived by convention:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;profile/{profileID}/attachments/{transactionID}/{attachmentName}&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="390" x="730" y="880" as="geometry" />
        </mxCell>
        <mxCell id="RM2FrNabXh4gKvRu5ezO-24" parent="1" style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" value="The database is single-currency: every amount is stored in the profile currency. transactions.currency and accounts.currency are labels only - reports never multiply by conversion_rate. A foreign account is isolated from the consolidated total by turning off consider_balance." vertex="1">
          <mxGeometry height="170" width="160" x="-560" y="760" as="geometry" />
        </mxCell>
