<mxfile host="Electron">
  <diagram id="backend-layers" name="Camadas do backend">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bl-1" value="&lt;b&gt;Camadas do backend compartilhado&lt;/b&gt; — raciocínio em docs/plans/backend-design.md" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="-50" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="bl-2" value="&lt;b&gt;Desktop — Electron&lt;/b&gt;&lt;br&gt;Renderer (UI) → IPC → &lt;i&gt;utilityProcess&lt;/i&gt;, dono da única conexão" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="10" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="bl-3" value="&lt;b&gt;Mobile — React Native / Expo&lt;/b&gt;&lt;br&gt;UI → chamada direta na thread JS" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="10" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="bl-4" value="&lt;b&gt;Serviço web (futuro)&lt;/b&gt;&lt;br&gt;Cliente → rotas HTTP num processo Node" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="440" y="10" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="bl-5" value="&lt;b&gt;packages/core&lt;/b&gt; — TypeScript puro: sem node:*, fs, electron, react-native nem new Date() (lint)" style="rounded=1;whiteSpace=wrap;html=1;align=right;verticalAlign=top;spacingRight=12;spacingTop=6;fontSize=13;arcSize=2;fillColor=none;strokeColor=#333333;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1100" height="640" as="geometry"/></mxCell>
        <mxCell id="bl-6" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;Valida a entrada na fronteira do transporte (origem não confiável) e produz DTOs tipados" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="bl-7" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;Recebe o DTO, delega ao Service e formata a resposta — devolve Promise" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="280" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="bl-8" value="&lt;b&gt;Service&lt;/b&gt; — toda a regra de negócio&lt;br&gt;• ponto único de validação (arcos exclusivos, paid × payment_date, sinal)&lt;br&gt;• unidade de trabalho numa transação síncrona&lt;br&gt;• Money: arredondamento só nas fronteiras, comparação com epsilon&lt;br&gt;• rotina de recálculo de saldos (consolidado e previsto, inicial e final)&lt;br&gt;• verificação de integridade e complemento de recorrências" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="520" height="140" as="geometry"/></mxCell>
        <mxCell id="bl-9" value="&lt;b&gt;Repository&lt;/b&gt; — único lugar com SQL&lt;br&gt;• snake_case ↔ camelCase, caixa dos UUIDs, carimbo de updated_at&lt;br&gt;• filtra deleted_at IS NULL em toda leitura&lt;br&gt;• captura da sincronização na mesma transação (futuro)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="550" width="520" height="130" as="geometry"/></mxCell>
        <mxCell id="bl-10" value="&lt;b&gt;Model&lt;/b&gt;&lt;br&gt;Entidades do domínio (Account, Transaction, Invoice…)&lt;br&gt;Value Objects: Money, ids marcados (AccountId…)&lt;br&gt;Imutáveis — usados pelo Service e montados pelo Repository" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="200" height="170" as="geometry"/></mxCell>
        <mxCell id="bl-11" value="Assincronia só na fronteira de transporte (IPC, ponte RN, HTTP). Dentro do core tudo é síncrono, para que nada intercale numa transação." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="bl-12" value="O core só conhece as portas. Cada plataforma fornece adaptadores finos, verificados pela mesma suíte de contrato." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="275" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="bl-13" value="&lt;b&gt;Clock&lt;/b&gt; — now() / today()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="880" y="380" width="230" height="40" as="geometry"/></mxCell>
        <mxCell id="bl-14" value="&lt;b&gt;IdGenerator&lt;/b&gt; — UUID v4 / v5" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="230" height="40" as="geometry"/></mxCell>
        <mxCell id="bl-15" value="&lt;b&gt;FileStore&lt;/b&gt; — anexos" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="880" y="480" width="230" height="40" as="geometry"/></mxCell>
        <mxCell id="bl-16" value="&lt;b&gt;Database&lt;/b&gt; — run, get, all,&lt;br&gt;transaction(fn) síncrona" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="bl-17" value="&lt;b&gt;Runner de migrations&lt;/b&gt;&lt;br&gt;pragmas → backup → migrations → integridade → recorrências" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="650" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="bl-18" value="&lt;b&gt;Adaptadores desktop e testes&lt;/b&gt;&lt;br&gt;better-sqlite3 · relógio do sistema&lt;br&gt;crypto.randomUUID · sistema de arquivos do Node" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="820" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="bl-19" value="&lt;b&gt;Adaptadores mobile&lt;/b&gt;&lt;br&gt;expo-sqlite (API síncrona) · relógio do sistema&lt;br&gt;gerador seguro do Expo · sistema de arquivos do Expo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=12;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="820" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="bl-20" value="&lt;b&gt;Arquivo SQLite&lt;/b&gt;&lt;br&gt;tabelas STRICT&lt;br&gt;foreign_keys ON · WAL&lt;br&gt;user_version = versão do schema" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="585" y="970" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="bl-21" value="&lt;b&gt;Anexos em disco&lt;/b&gt;&lt;br&gt;profile/{id}/attachments/&lt;br&gt;{transação}/{nome}" style="shape=folder;tabWidth=60;tabHeight=14;tabPosition=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="885" y="980" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="bl-22" value="&lt;b&gt;backups/&lt;/b&gt;&lt;br&gt;pre-v{N}-{data}.sqlite&lt;br&gt;gravado pelo runner antes de migrar" style="shape=folder;tabWidth=60;tabHeight=14;tabPosition=left;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="285" y="980" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="bl-23" value="IPC" style="endArrow=classic;html=1;rounded=0;fontSize=11;labelBackgroundColor=default;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15384615384615385;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bl-2" target="bl-6"><mxGeometry relative="1" as="geometry"/></mxCell>
